class Solution {
    public int[] twoSum(int[] arr, int target) {
        Map<Integer,Integer> map = new HashMap<>();
        int  n = arr.length;

        for(int i=0;i<n;i++){
            int k = target - arr[i];
            if(map.containsKey(k)) {
                return new int[] {map.get(k),i};
            }
            map.put(arr[i],i);
        }

        return new int[] {};
    }
}
