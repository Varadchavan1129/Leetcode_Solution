class Solution {
    public int[] applyOperations(int[] arr) {
        int n = arr.length;
        int[] ans = new int[n];
        int cnt = 0;
        for(int i=0;i<n-1;i++){
            if(arr[i]==arr[i+1]) {
                arr[i] = arr[i] * 2;
                arr[i+1] = 0;
            }
            if(arr[i]==0)cnt++;
        }
        int i=0;
        int j = n-1;
        int k = 0;
        while(i<n){
            if(arr[i]!=0){
               ans[k] = arr[i];
               k++;
               i++;
            }
            else{
                 ans[j] = arr[i];
                 i++;
                 j--;
            }
        }
        return ans;
    }
}
