class Solution {
    public int dominantIndex(int[] arr) {
        int n = arr.length;
        int max = Integer.MIN_VALUE;
        int ans = 0;
        for(int i=0;i<n;i++){
            if(max<=arr[i]){
                max = arr[i];
                ans = i;
            }
        }
        for(int i=0;i<n;i++) {
            if(arr[i]==max) continue;
            else if(arr[i]*2 > max) ans = -1;
        }
        return ans;
    }
}
